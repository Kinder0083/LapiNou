#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# git simulé : « clone » crée le dossier .git de la destination ; rev-parse rend abc1234
# (branche courante : STUB_GIT_BRANCH, défaut main).
# shellcheck source=installer/tests/stubs/_stub.sh
. "$(dirname "$0")/_stub.sh"
case " $* " in
    *" clone "*) mkdir -p "${*: -1}/.git" ;;
    *" rev-parse --abbrev-ref "*) echo "${STUB_GIT_BRANCH:-main}" ;;
    *" rev-parse "*) echo "abc1234" ;;
esac
exit 0
