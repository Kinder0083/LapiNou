#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# systemctl simulé : « restart lapinou » échoue STUB_RESTART_FAILS fois (défaut 0) avec le
# statut STUB_EXEC_STATUS (226 = NAMESPACE).
# shellcheck source=installer/tests/stubs/_stub.sh
. "$(dirname "$0")/_stub.sh"
case "$*" in
    "restart lapinou")
        n=$(( $(cat "$STUB_DIR/restarts" 2>/dev/null || echo 0) + 1 ))
        echo "$n" > "$STUB_DIR/restarts"
        [ "$n" -gt "${STUB_RESTART_FAILS:-0}" ] || exit 1 ;;
    "show -p ExecMainStatus --value lapinou")
        n=$(cat "$STUB_DIR/restarts" 2>/dev/null || echo 0)
        if [ "$n" -le "${STUB_RESTART_FAILS:-0}" ]; then echo "${STUB_EXEC_STATUS:-0}"; else echo 0; fi ;;
esac
exit 0
