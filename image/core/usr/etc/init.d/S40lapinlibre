#!/bin/sh
# SPDX-License-Identifier: MIT
# LapinLibre's core daemons, for startup.sh (start) and by hand (stop, restart): first the rabbit's
# UUID (/usr/karotz/uuid.conf, made once and kept by the install) and the button sounds' switch
# (/usr/etc/conf/playsounds, turned on once, the first time; the platform's settings may remove it
# later, and that stays); then the hardware and service daemons, each kept running by immortaldog
# (it restarts a daemon that dies and writes its own pid file), LapiNou's microphone (lapinou-mic,
# the only reader of /dev/audio) first, before voice-daemon and multimedia-daemon (which are to read
# the microphone from lapinou-mic's socket: wired in Task 6), LapiNou's mode without a server
# (lapinou-cloud, only when lapinou.conf has [cloud] enabled=1: it costs RAM; "S40lapinlibre cloud"
# starts or stops it after a change) and LapiNou's MQTT bridge to Home
# Assistant (lapinou-mqtt) last, once the daemons they drive are started; then the head button's watcher
# (/usr/scripts/dbus_watcher: tones and /etc/button.d hooks) and the web API's tag listener
# (/usr/scripts/tag_listener: tag learning and the tags' actions, as the user web, like the web API
# whose programs it runs; web-files.sh makes its files first), each also under immortaldog and
# never twice; then, once the daemons it talks to are on the bus (at most 15 s), the controller,
# which connects to the app server karotz.conf names and starts karotzVM for the applications; then
# mDNS: mdnsd answers to the host name (<name>.local) on wlan0 and advertises the services in
# /etc/mdns.d (SSH), started as Buildroot's own mdnsd script starts it. Last, LapiNou's daily update
# check in root's cron table (check only, never an install: webroot.sh ota check), added once.
# NAME: the program NAME-daemon, or NAME itself for LapiNou's (lapinou-*).
DAEMONS="lapinou-mic led rfid webcam button ears multimedia voice scheduler serial k2k lapinou-mqtt"
# The bus names the controller needs before it starts.
NEEDS="Led Ears Multimedia Voice Scheduler Rfid Button"
BIN=/usr/karotz/bin
RUN=/var/run/karotz
MDNSD=/usr/sbin/mdnsd
MDNSD_PID=/var/run/mdnsd.pid
MDNSD_ARGS="-i wlan0"
WATCHER=/usr/scripts/dbus_watcher
LISTENER=/usr/scripts/tag_listener
PLAYSOUNDS=/usr/etc/conf/playsounds
ACCOUNT=/usr/etc/conf/account.conf
UUID=/usr/karotz/uuid.conf
CONF_SH=/usr/share/lapinou/conf.sh
WEB_FILES=/karotz/scripts/web-files.sh
CRONTABS=/usr/spool/cron/crontabs
OTA_DAILY="/bin/sh /usr/share/lapinou/webroot.sh ota check"

# once NAME PROGRAM [USER]: PROGRAM under immortaldog with the pid file NAME.pid (as USER, when
# given), unless a live process holds that file already.
once() {
    pid=$(cat "$RUN/$1.pid" 2> /dev/null)
    if [ -z "$pid" ] || ! kill -0 "$pid" 2> /dev/null; then
        rm -f "$RUN/$1.pid"
        if [ -x "$2" ] && [ -n "${3:-}" ]; then
            $BIN/immortaldog "$RUN/$1.pid" /bin/busybox setuidgid "$3" "$2"
        elif [ -x "$2" ]; then
            $BIN/immortaldog "$RUN/$1.pid" "$2"
        fi
    fi
    return 0
}

# ota_cron: root's cron table gets the daily update check, at a minute of its own between 3:00 and
# 5:59, unless it has it already; crond reads the table again (cron.update).
ota_cron() {
    [ -d $CRONTABS ] || return 0
    grep -qF "$OTA_DAILY" $CRONTABS/root 2> /dev/null && return 0
    n=$(od -An -N2 -tu2 /dev/urandom 2> /dev/null | tr -cd 0-9)
    n=${n:-0}
    echo "$((n % 60)) $((3 + n / 60 % 3)) * * * $OTA_DAILY > /dev/null 2>&1" >> $CRONTABS/root &&
        echo root >> $CRONTABS/cron.update
}

# account_login: R47, the controller's platform login is the rabbit's uuid (as for lapinou-mic and
# MQTT), so the LapiNou server sees one rabbit. An install made before that (login "lapinlibre",
# or none) is put right here, before the controller starts; the password is kept.
account_login() {
    uuid=$(tr -d '[:space:]' < $UUID 2> /dev/null)
    [ -n "$uuid" ] || return 0
    login=$(sed -n 's/^id=//p' $ACCOUNT 2> /dev/null | head -n 1)
    [ "$login" = "$uuid" ] && return 0
    secret=$(sed -n 's/^pwd=//p' $ACCOUNT 2> /dev/null | head -n 1)
    printf '[account]\nid=%s\npwd=%s\n' "$uuid" "${secret:-lapinlibre}" > $ACCOUNT.new && mv -f $ACCOUNT.new $ACCOUNT &&
        logger -t S40lapinlibre "platform login set to the rabbit's uuid"
}

# cloud: lapinou-cloud (the mode without a server) runs only when [cloud] enabled=1; otherwise it
# is stopped (immortaldog ends it), so it takes no RAM.
cloud() {
    # shellcheck source=/dev/null
    enabled=$( (. $CONF_SH && lapinou_get cloud enabled) 2> /dev/null)
    if [ "$enabled" = 1 ]; then
        pid=$(cat "$RUN/lapinou-cloud.pid" 2> /dev/null)
        if [ -z "$pid" ] || ! kill -0 "$pid" 2> /dev/null; then
            rm -f "$RUN/lapinou-cloud.pid"
            $BIN/immortaldog "$RUN/lapinou-cloud.pid" "$BIN/lapinou-cloud"
        fi
    elif [ -f "$RUN/lapinou-cloud.pid" ]; then
        kill "$(cat "$RUN/lapinou-cloud.pid")" 2> /dev/null
        rm -f "$RUN/lapinou-cloud.pid"
    fi
    return 0
}

start() {
    [ -s $UUID ] || uuidgen > $UUID
    account_login
    if [ ! -e $PLAYSOUNDS.default ]; then
        [ -e $PLAYSOUNDS ] || echo 1 > $PLAYSOUNDS
        [ -e $PLAYSOUNDS ] && touch $PLAYSOUNDS.default
    fi
    mkdir -p $RUN
    for name in $DAEMONS; do
        case $name in
        lapinou-*) $BIN/immortaldog "$RUN/$name.pid" "$BIN/$name" ;;
        *) $BIN/immortaldog "$RUN/$name.pid" "$BIN/$name-daemon" ;;
        esac
    done
    cloud
    # The watcher and the listener, each only when no live process holds its pid file.
    once dbus_watcher $WATCHER
    $WEB_FILES
    once tag_listener $LISTENER web
    for i in $(seq 1 15); do
        missing=""
        for n in $NEEDS; do
            dbus-send --system --print-reply --dest=org.freedesktop.DBus /org/freedesktop/DBus org.freedesktop.DBus.NameHasOwner string:com.mindscape.karotz.$n 2> /dev/null | grep -q "boolean true" ||
                missing="$missing $n"
        done
        [ -z "$missing" ] && break
        sleep 1
    done
    [ -n "$missing" ] && logger -t S40lapinlibre "starting the controller without:$missing"
    $BIN/immortaldog "$RUN/controller.pid" "$BIN/controller"
    # shellcheck disable=SC2086
    start-stop-daemon -S -q -p $MDNSD_PID -x $MDNSD -- $MDNSD_ARGS
    ota_cron
}

stop() {
    start-stop-daemon -K -q -p $MDNSD_PID -x $MDNSD
    # immortaldog stops its daemon on SIGTERM and removes its pid file.
    for name in controller tag_listener dbus_watcher lapinou-cloud $DAEMONS; do
        [ -f "$RUN/$name.pid" ] && kill "$(cat "$RUN/$name.pid")" 2> /dev/null
    done
    return 0
}

case "$1" in
start) start ;;
stop) stop ;;
restart) stop; sleep 1; start ;;
cloud) cloud ;;
*) echo "Usage: $0 {start|stop|restart|cloud}"; exit 1 ;;
esac
