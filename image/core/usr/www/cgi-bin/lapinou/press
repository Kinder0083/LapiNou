#!/bin/sh
# SPDX-License-Identifier: MIT
# lapinou/press (POST only): the first web password's proof of presence (R46). While the page has
# no password, creating one needs a press on the rabbit's head: start makes the LED blink and waits
# 60 s for it; status says whether it came (then secret_set name=web_password is taken, once).
#   action  start or status
. /usr/share/lapinlibre/web.sh
web_begin change
. /usr/share/lapinou/web-lapinou.sh
lapinou_post
param_choice action status start status
lapinou_reply press "$PV" < /dev/null
