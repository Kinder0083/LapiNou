#!/bin/sh
# SPDX-License-Identifier: MIT
# lapinou/secret_set (POST only): stores a secret, never given back.
#   name   mqtt_password, cloud_stt_key, cloud_llm_key, cloud_tts_key, ota_token, wifi_password, or
#          web_password (the page's own password: httpd asks for it from the next request on)
#   value  the secret; empty removes it (not for the passwords)
# While secrets are stored and the page has no password, only web_password is taken.
. /usr/share/lapinlibre/web.sh
web_begin change
. /usr/share/lapinou/web-lapinou.sh
lapinou_post
param_choice name "" mqtt_password cloud_stt_key cloud_llm_key cloud_tts_key ota_token wifi_password web_password
name=$PV
[ -n "$name" ] || web_fail "Le paramètre name manque."
if [ "$name" != web_password ] || [ -s "$WEB_HASH" ]; then
    lapinou_guard
fi
param value
[ $? = 2 ] && web_fail "Le secret ne peut pas contenir de caractère de contrôle."
value=$PV
# A here-document, not a pipe: the reply (and its log line) stays in this shell. Its line end is
# dropped by webroot.sh, and a value never holds one. The page's password comes after the token of
# the press on the head that proves presence (lapinou/press; empty once there is a password).
if [ "$name" = web_password ]; then
    param token
    [ $? = 2 ] && web_fail "Le jeton ne peut pas contenir de caractère de contrôle."
    lapinou_reply secret "$name" << EOF
$PV
$value
EOF
fi
lapinou_reply secret "$name" << EOF
$value
EOF
