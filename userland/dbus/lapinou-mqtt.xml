<!-- lapinou-mqtt (userland/src/usr/lapinou-mqtt). Signal arguments are not listed: the generated server glue records only each signal's name, and the arguments are those the daemon's g_signal_new() declares (mqtt_state: s, "disabled", "connecting", "connected" or "disconnected"). -->
<node>
  <interface name="com.mindscape.karotz.LapinouMqtt">
    <method name="get_state">
      <arg name="state" type="s" direction="out"/>
    </method>
    <signal name="mqtt_state"/>
  </interface>
</node>
