<!-- lapinou-cloud (userland/src/usr/lapinou-cloud). Signal arguments are not listed: the generated server glue records only each signal's name, and the arguments are those the daemon's g_signal_new() declares (state: s, "listening", "thinking", "speaking", "idle" or "error"). -->
<node>
  <interface name="com.mindscape.karotz.LapinouCloud">
    <method name="start_listening"/>
    <method name="stop_listening"/>
    <method name="say">
      <arg name="text" type="s" direction="in"/>
    </method>
    <signal name="state"/>
  </interface>
</node>
