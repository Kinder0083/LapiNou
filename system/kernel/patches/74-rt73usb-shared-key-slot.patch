# rt73usb put every shared key in the first free slot of its key table, but the dongle finds a received frame's shared key by the frame's key index. A WPA2 group key has index 1 or 2 (1, 2, 1... at each renewal), so it landed in slot 0 and the dongle couldn't decrypt the network's broadcast and multicast frames: the rabbit missed most ARP requests, and a computer that didn't know it yet couldn't reach it. The key now goes in the slot of its index (4 per BSS), as in Ralink's own driver. Software decryption (nohwcrypt=1) avoided the loss, but lost the Wi-Fi about ten minutes after boot (v0.3.1).
--- a/drivers/net/wireless/rt2x00/rt73usb.c
+++ b/drivers/net/wireless/rt2x00/rt73usb.c
@@ -292,7 +292,15 @@
 		if (reg && reg == mask)
 			return -ENOSPC;
 
-		key->hw_key_idx += reg ? ffz(reg) : 0;
+		/*
+		 * RABBITV3: the dongle finds a received frame's shared key by
+		 * the frame's key index, so the key goes in that slot, not in
+		 * the first free one (was: key->hw_key_idx += ffz(reg)). A
+		 * WPA2 group key has index 1 or 2: in slot 0 the dongle failed
+		 * to decrypt the network's broadcast frames, ARP requests
+		 * among them.
+		 */
+		key->hw_key_idx = 4 * crypto->bssidx + (key->keyidx & 3);
 
 		/*
 		 * Upload key to hardware
